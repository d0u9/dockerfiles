#!/usr/bin/env python3
"""Find Cloudflare DNS records that point at an address, and repoint them."""

import os
import sys

sys.path[:0] = ["/usr/local/lib/ops", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")]
from opslib import parse, repoint_dns, run, usage_error  # noqa: E402

HELP = """
usage: ops-dns <ip>
       ops-dns <old-ip> <new-ip> [-y]

Find the Cloudflare DNS records that point at an address, and repoint them.

With one address, list the A or AAAA records whose content is that address.
With two, show those records, ask for confirmation, then change each one to
the new address. Name, proxy status and TTL are kept.

Every zone the token can read is searched. Addresses are compared as
addresses, not as text: any spelling of an IPv6 address matches. Both
addresses must be the same family: IPv4 changes A records, IPv6 AAAA records.

Options:
  -y         do not ask for confirmation
  -h, --help show this help

Needs CLOUDFLARE_API_TOKEN in an unlocked shell (ops-unlock or ops-paste).
The token needs Zone: Read and DNS: Edit on the zones to change.

Examples:
  ops-dns 203.0.113.10
  ops-dns 203.0.113.10 198.51.100.7
"""


def main(argv):
    flags, args = parse(argv, HELP, {"-y"})
    if len(args) not in (1, 2):
        usage_error(HELP)
    failed = repoint_dns(args[0], args[1] if len(args) == 2 else None, "-y" in flags)
    return 1 if failed else 0


run(main)
