# Only certificates signed by the mounted CA are accepted: no passwords, no
# authorized_keys. Cloudflare Access signs the part of the email before the @
# as the principal and the full email as the key ID. ops-principals accepts a
# certificate only when that full email is listed in /etc/ops/emails, so
# another domain's address with the same local part is refused.
Port 22
HostKey /var/lib/ops/ssh/ssh_host_ed25519_key

PubkeyAuthentication yes
TrustedUserCAKeys /etc/ops/ca.pub
AuthorizedKeysFile none
AuthorizedPrincipalsCommand /usr/local/sbin/ops-principals %u %i
AuthorizedPrincipalsCommandUser nobody

PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowGroups ops

AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no

# Every connection arrives from the tunnel connector's single address, so
# per-source penalties would end up locking out everyone at once.
PerSourcePenalties no

ClientAliveInterval 60
ClientAliveCountMax 3
LogLevel VERBOSE
